---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for item in site.pages %}
  {% if item.layout == 'default' and item.sitemap != false %}
  <url><loc>{{ item.url | replace: 'index.html', '' | absolute_url | xml_escape }}</loc></url>
  {% endif %}
  {% endfor %}
</urlset>
